# Paste these defaults into Railway Variables -> Raw Editor -> ENV.
# Add AFTERSET_OAUTH_PASSPHRASE separately with a private passphrase of at least
# 16 characters, saved in your password manager.
AFTERSET_DB=/data/afterset.db
AFTERSET_TOKEN_STORE=/data/garmin_tokens
AFTERSET_HOST=0.0.0.0
PORT=8080
RAILWAY_RUN_UID=0
# Change this to your own IANA timezone.
AFTERSET_TIMEZONE=Europe/London
