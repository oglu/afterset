# Examples only: Afterset does not automatically load .env files.
# Export settings in your CLI / MCP host environment, or configure the host's env.
# AFTERSET_DB=/absolute/path/to/afterset.db
# AFTERSET_CONTEXT_DB=/absolute/path/to/personal-context.db
# AFTERSET_TIMEZONE=Europe/London
# AFTERSET_TOKEN_STORE=/absolute/path/to/garmin_tokens

# Optional headless CLI login instead of the system keyring; supply both.
# GARMIN_EMAIL=your.email@example.com
# GARMIN_PASSWORD=your_garmin_password

# Optional HTTP mode (stdio ignores these). Use a generated secret, never commit it.
# Recommended hosted/mobile mode: owner passphrase, at least 16 characters.
# AFTERSET_OAUTH_PASSPHRASE=<private generated owner passphrase>
# Alternative scripts/IDE mode; do not set both authentication variables.
# AFTERSET_HTTP_TOKEN=<random ASCII token of at least 32 characters>
# AFTERSET_HOST=127.0.0.1
# AFTERSET_PORT=8765
# AFTERSET_PUBLIC_URL=https://afterset.example.com/mcp

# Opt-in official Garmin Personal API, instead of cached Connect login.
# AFTERSET_GARMIN_BACKEND=personal-api
# Prefer `afterset personal-api-setup` to enter and save the key privately.
# Alternative owner-managed secret: GARMIN_PERSONAL_API_KEY=<private API key>
